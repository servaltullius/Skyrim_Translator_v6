<UserControl x:Class="XTranslatorAi.App.Views.LqaTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <Button Content="검사" Command="{Binding ScanLqaCommand}" Style="{StaticResource XT.ToolbarButton}" />
            <Button Content="지우기" Command="{Binding ClearLqaCommand}" Style="{StaticResource XT.ToolbarButton}" />

            <Separator Margin="12,0,12,0" Width="1" />

            <TextBlock Text="검색:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding LqaFilterText, UpdateSourceTrigger=PropertyChanged}"
                     Width="320"
                     Style="{StaticResource XT.ToolbarTextBox}" />
            <CheckBox Content="참고 숨기기"
                      IsChecked="{Binding LqaHideInfo}"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0"
                      ToolTip="오류·경고만 보입니다. 참고는 다른 화자의 말투, 공식 이름, TM 대체처럼 확인만 하면 되는 결과입니다." />
            <TextBlock Text="{Binding LqaVisibleSummary, Mode=OneWay}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </WrapPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding LqaIssuesView}"
                  SelectedItem="{Binding SelectedLqaIssue}"
                  Style="{StaticResource XT.DataGrid}"
                  ColumnHeaderStyle="{StaticResource XT.DataGridColumnHeader}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  AlternationCount="2"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.IsDeferredScrollingEnabled="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="심각도" Binding="{Binding SeverityDisplay}" Width="70" />
                <DataGridTextColumn Header="종류" Binding="{Binding CodeDisplay}" Width="130" />
                <DataGridTextColumn Header="#" Binding="{Binding OrderIndex}" Width="70" />
                <DataGridTextColumn Header="EDID" Binding="{Binding Edid}" Width="140" />
                <DataGridTextColumn Header="REC" Binding="{Binding Rec}" Width="140" />
                <DataGridTextColumn Header="내용" Binding="{Binding Message}" Width="240" />
                <DataGridTextColumn Header="원문" Binding="{Binding SourcePreview}" Width="*" />
                <DataGridTextColumn Header="번역문" Binding="{Binding DestPreview}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource XT.BorderBrush}"
                      Opacity="0.7"
                      ShowsPreview="True" />

        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="원문" Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource XT.GroupBoxCard}">
                <TextBox Text="{Binding SelectedEntry.SourceText}"
                         IsReadOnly="True"
                         Style="{StaticResource XT.EditorTextBox}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </GroupBox>

            <GroupBox Header="번역문" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource XT.GroupBoxCard}">
                <DockPanel>
                    <Button DockPanel.Dock="Top"
                            Content="번역문 저장"
                            Command="{Binding SaveSelectedDestCommand}"
                            Style="{StaticResource XT.ToolbarButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8" />
                    <!-- EditableDestText marks typed text as unsaved; leaving the row saves it. -->
                    <TextBox Text="{Binding SelectedEntry.EditableDestText, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsTranslating}"
                             Style="{StaticResource XT.EditorTextBox}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>

