<UserControl x:Class="XTranslatorAi.App.Views.LqaTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <Button Content="검사" Command="{Binding ScanLqaCommand}" Style="{StaticResource XT.ToolbarButton}" />
            <Button Content="지우기" Command="{Binding ClearLqaCommand}" Style="{StaticResource XT.ToolbarButton}" />
            <Button Command="{Binding ToggleLqaReviewedCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=LqaIssuesGrid}"
                    ToolTip="고칠 필요가 없다고 본 결과(일부러 다르게 쓴 말투, 영어로 둔 모드 이름 등)를 표시합니다. 행의 번역문이 바뀌면 표시가 풀려 다시 나옵니다. 여러 결과를 골라 한 번에 표시할 수 있습니다.">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource XT.ToolbarButton}">
                        <Setter Property="Content" Value="확인함으로 표시" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedLqaIssue.IsReviewed}" Value="True">
                                <Setter Property="Content" Value="확인함 표시 해제" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Separator Margin="12,0,12,0" Width="1" />

            <TextBlock Text="검색:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding LqaFilterText, UpdateSourceTrigger=PropertyChanged}"
                     Width="320"
                     Style="{StaticResource XT.ToolbarTextBox}" />
            <CheckBox Content="참고 숨기기"
                      IsChecked="{Binding LqaHideInfo}"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0"
                      ToolTip="오류·경고만 보입니다. 참고는 다른 화자의 말투, TM의 이름 표기, TM 대체처럼 확인만 하면 되는 결과입니다." />
            <CheckBox Content="확인한 항목 숨기기"
                      IsChecked="{Binding LqaHideReviewed}"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0"
                      ToolTip="확인함으로 표시한 결과를 숨깁니다. 끄면 '확인' 칸에 '확인함'으로 보입니다." />
            <TextBlock Text="{Binding LqaVisibleSummary, Mode=OneWay}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </WrapPanel>

        <DataGrid Grid.Row="1"
                  x:Name="LqaIssuesGrid"
                  ItemsSource="{Binding LqaIssuesView}"
                  SelectedItem="{Binding SelectedLqaIssue}"
                  Style="{StaticResource XT.DataGrid}"
                  ColumnHeaderStyle="{StaticResource XT.DataGridColumnHeader}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  AlternationCount="2"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.IsDeferredScrollingEnabled="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="심각도" Binding="{Binding SeverityDisplay}" Width="70" />
                <DataGridTextColumn Header="확인" Binding="{Binding ReviewedDisplay}" Width="60" />
                <DataGridTextColumn Header="종류" Binding="{Binding CodeDisplay}" Width="130" />
                <DataGridTextColumn Header="#" Binding="{Binding OrderIndex}" Width="70" />
                <DataGridTextColumn Header="EDID" Binding="{Binding Edid}" Width="140" />
                <DataGridTextColumn Header="REC" Binding="{Binding Rec}" Width="140" />
                <DataGridTextColumn Header="내용" Binding="{Binding Message}" Width="240" />
                <DataGridTextColumn Header="원문" Binding="{Binding SourcePreview}" Width="*" />
                <DataGridTextColumn Header="번역문" Binding="{Binding DestPreview}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource XT.BorderBrush}"
                      Opacity="0.7"
                      ShowsPreview="True" />

        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="원문" Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource XT.GroupBoxCard}">
                <TextBox Text="{Binding SelectedEntry.SourceText}"
                         IsReadOnly="True"
                         Style="{StaticResource XT.EditorTextBox}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </GroupBox>

            <GroupBox Header="번역문" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource XT.GroupBoxCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="번역문 저장"
                                Command="{Binding SaveSelectedDestCommand}"
                                Style="{StaticResource XT.ToolbarButton}" />
                        <Button Command="{Binding ToggleSourceFixCommand}"
                                ToolTip="원문이 잘못돼서(다른 레코드 문장을 붙여 넣음, 뜻이 바뀌는 오타 등) 일부러 다르게 번역한 행입니다. 표시하면 품질 검사는 이 행의 태그만 확인합니다. 다시 번역하면 표시가 풀립니다.">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource XT.ToolbarButton}">
                                    <Setter Property="Content" Value="원문 오류 수정으로 표시" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedEntry.IsSourceFix}" Value="True">
                                            <Setter Property="Content" Value="원문 오류 수정 표시 해제" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <!-- EditableDestText marks typed text as unsaved; leaving the row saves it. -->
                    <TextBox Text="{Binding SelectedEntry.EditableDestText, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsTranslating}"
                             Style="{StaticResource XT.EditorTextBox}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>

