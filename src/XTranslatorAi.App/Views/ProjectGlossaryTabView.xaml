<UserControl x:Class="XTranslatorAi.App.Views.ProjectGlossaryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="분류:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding GlossaryCategory}" Width="180" Style="{StaticResource XT.ToolbarTextBox}" Margin="0,0,12,0" />

            <TextBlock Text="원문:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding GlossarySourceTerm, UpdateSourceTrigger=PropertyChanged}" Width="220" Style="{StaticResource XT.ToolbarTextBox}" />
            <TextBlock Text="번역어:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding GlossaryTargetTerm, UpdateSourceTrigger=PropertyChanged}" Width="220" Style="{StaticResource XT.ToolbarTextBox}" />

            <TextBlock Text="일치 방식:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding GlossaryMatchModeValues}"
                      ItemTemplate="{StaticResource XT.EnumDisplayTemplate}"
                      SelectedItem="{Binding GlossaryMatchMode}"
                      Width="160"
                      Margin="0,0,12,0"
                      Style="{StaticResource XT.ToolbarComboBox}" />
            <TextBlock Text="적용 방식:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding GlossaryForceModeValues}"
                      ItemTemplate="{StaticResource XT.EnumDisplayTemplate}"
                      SelectedItem="{Binding GlossaryForceMode}"
                      Width="160"
                      Margin="0,0,12,0"
                      Style="{StaticResource XT.ToolbarComboBox}" />
            <TextBlock Text="우선순위:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding GlossaryPriority}" Width="60" Style="{StaticResource XT.ToolbarTextBox}" TextAlignment="Center" />

            <Button Content="추가" Command="{Binding AddGlossaryCommand}" Style="{StaticResource XT.ToolbarButton}" />
            <Button Content="저장" Command="{Binding SaveGlossaryChangesCommand}" Style="{StaticResource XT.ToolbarButton}" />
            <Button Content="삭제" Command="{Binding DeleteGlossaryEntryCommand}" Style="{StaticResource XT.ToolbarButton}" />
            <Button Content="파일 가져오기" Command="{Binding ImportGlossaryCommand}" Style="{StaticResource XT.ToolbarButton}" />
            <Button Content="파일 내보내기" Command="{Binding ExportGlossaryCommand}" Style="{StaticResource XT.ToolbarButton}" />
            <Button Content="폴더 열기" Command="{Binding OpenGlossaryFolderCommand}" Style="{StaticResource XT.ToolbarButton}" />
        </WrapPanel>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="필터:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding GlossaryCategoryFilterValues}"
                      SelectedItem="{Binding GlossaryFilterCategory}"
                      Width="220"
                      Margin="0,0,12,0"
                      Style="{StaticResource XT.ToolbarComboBox}" />
            <TextBlock Text="검색:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding GlossaryFilterText, UpdateSourceTrigger=PropertyChanged}"
                     Width="260"
                     Style="{StaticResource XT.ToolbarTextBox}" />
        </WrapPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding GlossaryView}"
                  SelectedItem="{Binding SelectedGlossaryEntry}"
                  Style="{StaticResource XT.DataGrid}"
                  ColumnHeaderStyle="{StaticResource XT.DataGridColumnHeader}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AlternationCount="2"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding DeleteGlossaryEntryCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="사용" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                <DataGridTextColumn Header="분류" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                <DataGridTextColumn Header="원문" Binding="{Binding SourceTerm, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridTextColumn Header="번역어" Binding="{Binding TargetTerm, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridTemplateColumn Header="일치 방식" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MatchMode, Converter={StaticResource XT.EnumDisplay}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.GlossaryMatchModeValues, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      ItemTemplate="{StaticResource XT.EnumDisplayTemplate}"
                                      SelectedItem="{Binding MatchMode, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource XT.ToolbarComboBox}"
                                      Margin="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="적용 방식" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ForceMode, Converter={StaticResource XT.EnumDisplay}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.GlossaryForceModeValues, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      ItemTemplate="{StaticResource XT.EnumDisplayTemplate}"
                                      SelectedItem="{Binding ForceMode, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource XT.ToolbarComboBox}"
                                      Margin="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="우선순위" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                <DataGridTextColumn Header="메모" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="260" />
                <DataGridCheckBoxColumn Header="변경됨" Binding="{Binding IsDirty}" IsReadOnly="True" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
