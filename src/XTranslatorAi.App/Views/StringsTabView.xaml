<UserControl x:Class="XTranslatorAi.App.Views.StringsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:XTranslatorAi.Core.Models;assembly=XTranslatorAi.Core"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="검색:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="SearchBox" Text="{Binding EntryFilterText, UpdateSourceTrigger=PropertyChanged}"
                     Width="260"
                     ToolTip="문구·EDID 검색(Ctrl+F). 정확한 위치: form:01000800 / string:STRINGS/123 / row:0"
                     Style="{StaticResource XT.ToolbarTextBox}" />
            <TextBlock Text="{Binding VisibleEntrySummary, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{StaticResource XT.MutedTextBrush}" />

            <TextBlock Text="상태:" VerticalAlignment="Center" Margin="12,0,6,0" />
            <ComboBox ItemsSource="{Binding EntryStatusFilterValues}"
                      SelectedItem="{Binding EntryFilterStatus}"
                      Width="160"
                      Style="{StaticResource XT.ToolbarComboBox}" />

            <CheckBox Content="보호 요소(원문)만"
                      IsChecked="{Binding EntryFilterTagsOnly}"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0"
                      ToolTip="원문에 태그·페이지·변수(%s, {name}, __XT_*__)·줄바꿈 등 보호 요소가 포함된 항목만 표시합니다." />

            <CheckBox Content="보호 요소 불일치만"
                      IsChecked="{Binding EntryFilterTagMismatchOnly}"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0"
                      ToolTip="태그·페이지·변수(%s, {name})·줄바꿈·서식 순서 등 저장 보호 검사에 실패하는 항목만 표시합니다." />

            <Separator Margin="12,0,12,0" Width="1" />

            <Button Content="선택 행 다시 번역"
                    Command="{Binding RetranslateSelectedCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=EntriesGrid}"
                    Style="{StaticResource XT.ToolbarButton}"
                    ToolTip="표에서 고른 행(Ctrl·Shift로 여러 개)의 번역을 지우고 대기로 되돌립니다. '번역 시작'을 누르면 다시 번역합니다." />
            <Button Content="보이는 행 모두 다시 번역"
                    Command="{Binding RetranslateVisibleCommand}"
                    Style="{StaticResource XT.ToolbarButton}"
                    ToolTip="검색·상태 조건에 맞아 목록에 보이는 행을 모두 대기로 되돌립니다. '번역 시작'을 누르면 다시 번역합니다." />
        </WrapPanel>

        <DataGrid x:Name="EntriesGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding EntriesView}"
                  SelectedItem="{Binding SelectedEntry}"
                  SelectionMode="Extended"
                  Style="{StaticResource XT.DataGrid}"
                  ColumnHeaderStyle="{StaticResource XT.DataGridColumnHeader}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  AlternationCount="2"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.IsDeferredScrollingEnabled="True">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="선택 행 다시 번역"
                              Command="{Binding RetranslateSelectedCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
	            <DataGrid.RowStyle>
	                <Style TargetType="{x:Type DataGridRow}">
	                    <Setter Property="ToolTip" Value="{Binding RowToolTip}" />
	                    <Style.Triggers>
	                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StringEntryStatus.InProgress}">
	                            <Setter Property="Background" Value="{StaticResource XT.Row.InProgressBrush}" />
	                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StringEntryStatus.Done}">
                            <Setter Property="Background" Value="{StaticResource XT.Row.DoneBrush}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Status}" Value="{x:Static models:StringEntryStatus.Done}" />
                                <Condition Binding="{Binding IsTranslationMemoryApplied}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource XT.Row.DoneTmBrush}" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StringEntryStatus.Error}">
                            <Setter Property="Background" Value="{StaticResource XT.Row.ErrorBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StringEntryStatus.Skipped}">
                            <Setter Property="Background" Value="{StaticResource XT.Row.SkippedBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StringEntryStatus.Edited}">
                            <Setter Property="Background" Value="{StaticResource XT.Row.EditedBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
	            <DataGrid.Columns>
	                <DataGridTextColumn Header="#" Binding="{Binding OrderIndex}" Width="70" />
	                <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="90" />
	                <DataGridTextColumn Header="EDID" Binding="{Binding Edid}" Width="140" />
	                <DataGridTextColumn Header="REC" Binding="{Binding Rec}" Width="140" />
	                <DataGridTextColumn Header="오류" Binding="{Binding UserFacingErrorMessage}" Width="220" />
	                <DataGridTextColumn Header="원문" Binding="{Binding SourcePreview}" Width="*" />
	                <DataGridTextColumn Header="번역문" Binding="{Binding DestPreview}" Width="*" />
	            </DataGrid.Columns>
	        </DataGrid>

        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource XT.BorderBrush}"
                      Opacity="0.7"
                      ShowsPreview="True" />

        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="원문" Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource XT.GroupBoxCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedEntry.PluginLocationText}"
                               TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{StaticResource XT.MutedTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEntry.PluginLocationText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedEntry.PreviousTranslationText}"
                               TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{StaticResource XT.MutedTextBrush}"
                               ToolTip="이전 번역판의 같은 레코드 번역입니다. 번역할 때 참고 자료로 보냅니다.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEntry.PreviousTranslationText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                <TextBox Text="{Binding SelectedEntry.SourceText}"
                         IsReadOnly="True"
                         Style="{StaticResource XT.EditorTextBox}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </GroupBox>

            <GroupBox Header="번역문" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource XT.GroupBoxCard}">
                <DockPanel>
                    <Button DockPanel.Dock="Top"
                            Content="번역문 저장"
                            Command="{Binding SaveSelectedDestCommand}"
                            ToolTip="Ctrl+S: 저장 · Ctrl+Enter: 저장하고 다음 행 · F8 / Shift+F8: 다음·이전 대기·오류 행"
                            Style="{StaticResource XT.ToolbarButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8" />
                    <TabControl BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource XT.TabItem}">
                        <TabItem Header="편집">
                            <!-- EditableDestText marks typed text as unsaved; leaving the row saves it. -->
                            <TextBox Text="{Binding SelectedEntry.EditableDestText, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsTranslating}"
                                     ToolTip="{Binding DestEditorToolTip}"
                                     Style="{StaticResource XT.EditorTextBox}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" />
                        </TabItem>

                        <TabItem Header="용어">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="검색:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding GlossaryLookupText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="240"
                                             Style="{StaticResource XT.ToolbarTextBox}" />

                                    <CheckBox Content="프로젝트"
                                              IsChecked="{Binding GlossaryLookupIncludeProject}"
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0" />
                                    <CheckBox Content="전체"
                                              IsChecked="{Binding GlossaryLookupIncludeGlobal}"
                                              VerticalAlignment="Center"
                                              Margin="8,0,0,0" />
                                </WrapPanel>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding GlossaryLookupResultsView}"
                                          Style="{StaticResource XT.DataGrid}"
                                          ColumnHeaderStyle="{StaticResource XT.DataGridColumnHeader}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          AlternationCount="2"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.IsDeferredScrollingEnabled="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="범위" Binding="{Binding Scope}" Width="90" />
                                        <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="140" />
                                        <DataGridTextColumn Header="원문" Binding="{Binding SourceTerm}" Width="*" />
                                        <DataGridTextColumn Header="번역어" Binding="{Binding TargetTerm}" Width="*" />
                                        <DataGridTextColumn Header="우선순위" Binding="{Binding Priority}" Width="90" />
                                        <DataGridTextColumn Header="메모" Binding="{Binding Note}" Width="220" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- Shown until a project is open, so the empty grid explains where to start. -->
        <Border Grid.Row="1" Grid.RowSpan="3" Background="{StaticResource XT.SurfaceBrush}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProjectLoaded}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                <TextBlock Text="번역할 파일을 열어 주세요" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource XT.MutedTextBrush}" LineHeight="22">
                    상단의 <Bold>XML 열기</Bold>로 xTranslator XML을, <Bold>ESP 열기</Bold>로 ESP·ESM·ESL 플러그인을 불러옵니다.
                    <LineBreak />
                    API 키와 배치 크기 같은 설정은 <Bold>고급 설정</Bold>에서 바꿀 수 있습니다.
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
