<UserControl x:Class="XTranslatorAi.App.Views.GlobalTranslationMemoryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="원문:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding FranchiseTranslationMemorySourceText, UpdateSourceTrigger=PropertyChanged}" Width="320" Style="{StaticResource XT.ToolbarTextBox}" />
            <TextBlock Text="번역문:" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Text="{Binding FranchiseTranslationMemoryDestText, UpdateSourceTrigger=PropertyChanged}" Width="320" Style="{StaticResource XT.ToolbarTextBox}" />

            <Button Content="추가" Command="{Binding AddFranchiseTranslationMemoryCommand}" Style="{StaticResource XT.ToolbarButton}" />
            <Button Content="저장" Command="{Binding SaveFranchiseTranslationMemoryChangesCommand}" Style="{StaticResource XT.ToolbarButton}" />
            <Button Content="삭제" Command="{Binding DeleteFranchiseTranslationMemoryEntryCommand}" Style="{StaticResource XT.ToolbarButton}" />
            <Button Content="다시 불러오기" Command="{Binding ReloadFranchiseTranslationMemoryCommand}" Style="{StaticResource XT.ToolbarButton}" />
            <Button Content="파일 가져오기" Command="{Binding ImportFranchiseTranslationMemoryFromTabCommand}" Style="{StaticResource XT.ToolbarButton}" />
            <Button Content="파일 내보내기" Command="{Binding ExportFranchiseTranslationMemoryCommand}" Style="{StaticResource XT.ToolbarButton}" />
        </WrapPanel>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <Button Content="게임 번역 사전 만들기" Command="{Binding BuildGameStringDictionaryCommand}" Style="{StaticResource XT.ToolbarButton}"
                    ToolTip="게임의 영어 문자열과 설치한 한글패치를 짝지어 사전을 만듭니다. 모드가 원본 게임의 레코드나 문장을 그대로 쓰면 번역 없이 한글패치 번역을 씁니다. (API 호출 없음)" />
            <TextBlock Text="{Binding GameStringStatus}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource XT.MutedTextBrush}" />
        </WrapPanel>

        <WrapPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="검색:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding FranchiseTranslationMemoryFilterText, UpdateSourceTrigger=PropertyChanged}"
                     Width="260"
                     Style="{StaticResource XT.ToolbarTextBox}" />
        </WrapPanel>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding FranchiseTranslationMemoryView}"
                  SelectedItem="{Binding SelectedFranchiseTranslationMemoryEntry}"
                  Style="{StaticResource XT.DataGrid}"
                  ColumnHeaderStyle="{StaticResource XT.DataGridColumnHeader}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AlternationCount="2"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding DeleteFranchiseTranslationMemoryEntryCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="90" />
                <DataGridTextColumn Header="원문" Binding="{Binding SourceText}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="번역문" Binding="{Binding DestText, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridTextColumn Header="수정 시각" Binding="{Binding UpdatedAt}" IsReadOnly="True" Width="220" />
                <DataGridCheckBoxColumn Header="변경됨" Binding="{Binding IsDirty}" IsReadOnly="True" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
