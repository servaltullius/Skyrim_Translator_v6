<Window x:Class="XTranslatorAi.App.SelectNexusModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus 모드 선택"
        Height="520"
        Width="980"
        MinHeight="420"
        MinWidth="760"
        Style="{StaticResource XT.Window}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="ModsGrid"
                  Grid.Row="0"
                  Style="{StaticResource XT.DataGrid}"
                  ColumnHeaderStyle="{StaticResource XT.DataGridColumnHeader}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  AlternationCount="2"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="모드 ID" Binding="{Binding ModId}" Width="90" />
                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="260" />
                <DataGridTextColumn Header="버전" Binding="{Binding Version}" Width="100" />
                <DataGridTextColumn Header="도메인" Binding="{Binding DomainName}" Width="160" />
                <DataGridTextColumn Header="요약" Binding="{Binding Summary}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="맞는 모드를 고른 뒤 확인을 누르세요." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="확인" Width="90" Margin="6,0,0,0" Click="Ok_Click" />
                <Button Content="취소" Width="90" Margin="6,0,0,0" Click="Cancel_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

