<Window x:Class="XTranslatorAi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XTranslatorAi.App"
        xmlns:vm="clr-namespace:XTranslatorAi.App.ViewModels"
        xmlns:models="clr-namespace:XTranslatorAi.Core.Models;assembly=XTranslatorAi.Core"
        xmlns:views="clr-namespace:XTranslatorAi.App.Views"
        mc:Ignorable="d"
        Title="Tullius Translator" Height="900" Width="1400" MinHeight="720" MinWidth="1100"
        Style="{StaticResource XT.Window}"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource XT.CardBorder}" Margin="0,0,0,10" IsEnabled="{Binding IsWorkspaceInteractive}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Content="XML 열기" Command="{Binding OpenXmlCommand}" Style="{StaticResource XT.ToolbarButton}"
                                ToolTip="xTranslator XML을 엽니다. XML 파일을 창에 끌어다 놓아도 열립니다." />
                        <Button Content="XML 내보내기" Command="{Binding ExportXmlCommand}" Style="{StaticResource XT.ToolbarButton}" />
                        <Button Content="ESP 열기" Command="{Binding OpenPluginCommand}" Style="{StaticResource XT.ToolbarButton}"
                                ToolTip="고급 설정의 게임·언어·인코딩으로 ESP/ESM/ESL을 읽습니다. 원본은 수정하지 않습니다. 파일을 창에 끌어다 놓아도 열립니다." />
                        <Button Content="ESP 저장" Command="{Binding ExportPluginCommand}" Style="{StaticResource XT.ToolbarButton}"
                                ToolTip="새 출력 폴더에 원본 플러그인 이름을 유지하여 저장합니다." />
                        <Button Content="용어집 폴더" Command="{Binding OpenGlossaryFolderCommand}" Style="{StaticResource XT.ToolbarButton}"
                                ToolTip="%LOCALAPPDATA%\\XTranslatorAi\\ (Projects/Global) 폴더를 엽니다." />
                    </WrapPanel>

                    <Border Grid.Column="1" Width="1" Margin="0,6,12,6" Background="{StaticResource XT.BorderBrush}" />

                    <DockPanel Grid.Column="2" VerticalAlignment="Center" LastChildFill="False">
                        <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="번역 시작" Command="{Binding StartTranslationCommand}" Style="{StaticResource XT.SuccessButton}" Margin="0,0,6,0" />
                            <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseTranslationCommand}" Style="{StaticResource XT.ToolbarButton}" />
                            <Button Content="중지" Command="{Binding StopTranslationCommand}" Style="{StaticResource XT.DangerButton}" />
                        </WrapPanel>

                    </DockPanel>

                    <Border Grid.Column="3" Width="1" Margin="12,6,12,6" Background="{StaticResource XT.BorderBrush}" />

                    <WrapPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" IsEnabled="{Binding IsWorkspaceInteractive}">
                        <TextBlock Text="게임 시리즈:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding FranchiseOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedFranchise}"
                                  IsEnabled="{Binding CanChangeFranchise}"
                                  ToolTipService.ShowOnDisabled="True"
                                  ToolTip="전체 용어집·시리즈 TM·프롬프트를 이 게임 기준으로 씁니다. 번역 중에는 바꿀 수 없습니다."
                                  Width="140"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource XT.ToolbarComboBox}" />
                        <Border Width="1" Height="18" Margin="12,0,12,0" Background="{StaticResource XT.BorderBrush}" />
                        <TextBlock Text="모델:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding SelectedModel}"
                                  Width="220"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource XT.ToolbarComboBox}" />
                        <Button Content="새로고침" Command="{Binding RefreshModelsCommand}" Style="{StaticResource XT.ToolbarButton}" />
                    </WrapPanel>
                </Grid>

                <Expander Grid.Row="1" Margin="0,8,0,0" IsExpanded="False">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="고급 설정" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="{StaticResource XT.MutedTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding BatchSize, StringFormat=배치 {0}}" />
                                <Run Text=" · " />
                                <Run Text="{Binding MaxCharsPerBatch, StringFormat=최대 {0}자}" />
                                <Run Text=" · " />
                                <Run Text="{Binding MaxParallelRequests, StringFormat=동시 {0}}" />
                                <Run Text=" · " />
                                <Run Text="{Binding MaxOutputTokensOverride, StringFormat=출력 상한 {0}}" />
                            </TextBlock>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="ESP 불러오기 설정 (다음 Open ESP에 적용)" FontWeight="SemiBold" Foreground="{StaticResource XT.MutedTextBrush}" Margin="0,4,0,4" />
                        <WrapPanel IsEnabled="{Binding IsWorkspaceInteractive}" Margin="0,0,0,4">
                            <TextBlock Text="게임:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding PluginGameChoices}" SelectedItem="{Binding PluginGameSelection}" Width="310" Style="{StaticResource XT.ToolbarComboBox}" />
                            <TextBlock Text="원문 언어:" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <ComboBox ItemsSource="{Binding PluginLanguageChoices}" SelectedItem="{Binding PluginSourceLanguage}" Width="110" Style="{StaticResource XT.ToolbarComboBox}" />
                            <TextBlock Text="번역 언어:" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <ComboBox ItemsSource="{Binding PluginLanguageChoices}" SelectedItem="{Binding PluginTargetLanguage}" Width="110" Style="{StaticResource XT.ToolbarComboBox}" />
                            <TextBlock Text="원문 인코딩:" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <ComboBox ItemsSource="{Binding PluginEncodingChoices}" SelectedItem="{Binding PluginSourceEncoding}" Width="155" Style="{StaticResource XT.ToolbarComboBox}"
                                      ToolTip="utf-8 / windows-1252(CP1252) / ks_c_5601-1987(CP949). 원본의 실제 인코딩을 선택하세요." />
                            <TextBlock Text="메타데이터 인코딩:" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <ComboBox ItemsSource="{Binding PluginEncodingChoices}" SelectedItem="{Binding PluginMetadataEncoding}" Width="155" Style="{StaticResource XT.ToolbarComboBox}"
                                      ToolTip="EDID·마스터 파일명 해석용입니다(기본 CP1252). 원문/출력 인코딩과 독립이며 원본 메타데이터 바이트는 유지합니다." />
                            <TextBlock Text="출력 인코딩:" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <ComboBox ItemsSource="{Binding PluginEncodingChoices}" SelectedItem="{Binding PluginTargetEncoding}" Width="155" Style="{StaticResource XT.ToolbarComboBox}" />
                            <TextBlock Text="Strings 폴더:" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <TextBox Text="{Binding PluginStringsDirectory, UpdateSourceTrigger=LostFocus}" Width="300" Style="{StaticResource XT.ToolbarTextBox}"
                                     ToolTip="지역화 플러그인의 STRINGS/DLSTRINGS/ILSTRINGS 폴더입니다. 비워두면 플러그인 위치에서 찾습니다." />
                        </WrapPanel>
                        <TextBlock Text="번역 설정" FontWeight="SemiBold" Foreground="{StaticResource XT.MutedTextBrush}" Margin="0,4,0,4" />
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="배치:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource XT.ToolbarTextBox}"
                                     TextAlignment="Center" />
                            <TextBlock Text="최대 글자:" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <TextBox Text="{Binding MaxCharsPerBatch, UpdateSourceTrigger=PropertyChanged}" Width="80" VerticalAlignment="Center" Style="{StaticResource XT.ToolbarTextBox}" TextAlignment="Center" />
                            <TextBlock Text="동시 요청:" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <TextBox Text="{Binding MaxParallelRequests, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource XT.ToolbarTextBox}"
                                     TextAlignment="Center" />

                            <TextBlock Text="출력 상한:" VerticalAlignment="Center" Margin="12,0,6,0" ToolTip="0=자동(모델 한도)" />
                            <TextBox Text="{Binding MaxOutputTokensOverride, UpdateSourceTrigger=PropertyChanged}" Width="80" VerticalAlignment="Center" Style="{StaticResource XT.ToolbarTextBox}" TextAlignment="Center" ToolTip="0=자동(모델 한도)" />
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="행별 추가 요청:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding MaxRetryGenerations, UpdateSourceTrigger=LostFocus}" Width="60"
                                     Style="{StaticResource XT.ToolbarTextBox}" TextAlignment="Center"
                                     ToolTip="원본 행마다 허용할 추가 생성 요청 수입니다(0~100, 기본 8). 수리·분할 재시도에도 적용됩니다. 0이면 추가 생성을 막습니다." />
                            <TextBlock Text="작업 요청 상한:" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <TextBox Text="{Binding MaxTotalGenerations, UpdateSourceTrigger=LostFocus}" Width="80"
                                     Style="{StaticResource XT.ToolbarTextBox}" TextAlignment="Center"
                                     ToolTip="작업 전체의 생성 요청 수 상한입니다. 0=작업 크기에 따라 자동 계산, 양수=직접 지정. countTokens·캐시 호출은 제외합니다." />
                        </WrapPanel>
                        <TextBlock Text="{Binding EffectiveGeminiTranslationConfigSummary}"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource XT.MutedTextBrush}"
                                   ToolTip="{Binding EffectiveGeminiTranslationConfigToolTip}" />
                        <TextBlock Text="{Binding SelectedModelCostSummary}"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource XT.MutedTextBrush}" />

	                        <TextBlock Text="옵션" FontWeight="SemiBold" Foreground="{StaticResource XT.MutedTextBrush}" Margin="0,10,0,4" />
	                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
	                            <Button Content="저비용 프리셋" Command="{Binding ApplyFreeTierPresetCommand}" Style="{StaticResource XT.ToolbarButton}"
	                                    ToolTip="기본 모델을 Flash-Lite, 배치 8, 최대 15000자, 동시 1, 출력 Auto, 캐시 OFF로 적용합니다. 책/품질 모델·복구·실험 설정은 유지합니다. 이 설정이 무료 사용을 보장하지는 않습니다." />
	                            <Button Content="유료 프리셋" Command="{Binding ApplyPaidPresetCommand}" Style="{StaticResource XT.ToolbarButton}" Margin="6,0,0,0"
	                                    ToolTip="기본 모델을 Flash, 배치 12, 최대 15000자, 동시 2, 출력 Auto, 캐시 ON으로 적용합니다. 책/품질 모델·복구·실험 설정은 유지합니다." />
	                        </WrapPanel>
	                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
	                            <CheckBox Content="자동 복구" IsChecked="{Binding EnableRepairPass}" VerticalAlignment="Center" Margin="12,0,0,0"
	                                      ToolTip="번역 결과가 토큰/형식 검증에 실패하거나 플레이스홀더(&lt;mag&gt;/&lt;dur&gt;/&lt;숫자&gt;) 문맥이 이상하면 해당 항목을 추가로 재요청(필요 시 묶음)하여 복구합니다. 비용이 증가할 수 있습니다." />
                            <ComboBox ItemsSource="{Binding SemanticRepairModeValues}"
                                      SelectedItem="{Binding SemanticRepairMode}"
                                      IsEnabled="{Binding EnableRepairPass}"
                                      Width="90"
                                      VerticalAlignment="Center"
                                      Margin="6,0,0,0"
                                      Style="{StaticResource XT.ToolbarComboBox}"
                                      ToolTip="Semantic repair 강도입니다. Soft=명백한 &lt;dur&gt; 시간 문맥 오류만 추가 복구. Strict=조사/어순까지 포함해 더 공격적으로 복구합니다. (일반적으로 Strict가 더 느리고 비용이 큼)" />

                            <CheckBox Content="템플릿 교정" IsChecked="{Binding EnableTemplateFixer}" VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="번역 후 MagDurPlaceholderFixer(규칙/템플릿) 기반으로 일부 문장 패턴을 결정적으로 교정합니다. 끄면 LLM 결과/자동 복구에만 의존합니다." />

                            <CheckBox Content="태그 원문(&lt;mag&gt;/&lt;dur&gt;)" IsChecked="{Binding KeepSkyrimTagsRaw}" VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="실험 옵션: &lt;mag&gt;/&lt;dur&gt;(&lt;bur&gt; 포함)은 __XT_PH_*__로 마스킹하지 않고 원문 형태로 모델에 전달합니다. 일부 모델에서 문맥(포인트/초) 이해가 개선될 수 있지만, 태그 누락/변형 가능성도 있어 검증/자동복구와 함께 사용하는 것을 권장합니다." />

                            <CheckBox Content="대화 문맥(윈도우)" IsChecked="{Binding EnableDialogueContextWindow}" VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="DIAL/INFO 번역 시 이전/다음 대사를 참고 정보로 함께 보내 문맥을 개선합니다. 안전을 위해 ctx에는 태그/토큰을 제외한 텍스트만 들어갑니다." />

                            <CheckBox Content="세션 용어 메모리" IsChecked="{Binding EnableSessionTermMemory}" VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="이름·제목에서 학습한 용어를 이후 요청에 참고 힌트로 전달합니다. 대사는 학습 대상에서 제외합니다. 새 용어는 프로젝트 용어집의 Auto(Session)에 비활성 후보로 저장되며, 검토 후 직접 활성화할 수 있습니다." />

                            <CheckBox Content="프롬프트 캐시" IsChecked="{Binding EnablePromptCache}" VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="첫 실제 번역 요청에서 System prompt 캐시를 만들고 재사용합니다. 번역 메모리만 재사용하면 캐시를 만들지 않습니다. 캐시 생성이 지원되지 않으면 일반 요청으로 진행합니다. 캐시 저장 비용과 생성·삭제 호출이 추가되므로 절감 효과는 사용량에 따라 다릅니다." />

                            <CheckBox Content="품질 재번역(Flash)" IsChecked="{Binding EnableQualityEscalation}" VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="저오탐 품질 규칙(예: '초 초', '효과 효과', '%포인트' 등)이 감지되면 해당 항목만 2차 모델로 1회 재번역합니다. 무료 티어에서 전체를 고급 모델로 돌리는 대신, 문제 항목만 선별해 품질을 올릴 때 유용합니다." />
                            <ComboBox ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding QualityEscalationModel}"
                                      IsEnabled="{Binding EnableQualityEscalation}"
                                      Width="220"
                                      VerticalAlignment="Center"
                                      Margin="6,0,0,0"
                                      Style="{StaticResource XT.ToolbarComboBox}"
                                      ToolTip="품질 재번역에 사용할 모델입니다. (예: gemini-3.8-flash)" />

                            <CheckBox Content="위험문장 다중후보"
                                      IsChecked="{Binding EnableRiskyCandidateRerank}"
                                      IsEnabled="{Binding SelectedModelSupportsMultipleCandidates}"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0"
                                      ToolTip="구문 충돌 위험이 높은 문장(예: protect A from B, 복합 접속/대조 구문)에 대해 다중 후보를 생성하고 품질 점수로 최종 후보를 선택합니다. 비용이 증가할 수 있습니다." />
                            <TextBlock Text="후보 수:" VerticalAlignment="Center" Margin="6,0,4,0" />
                            <TextBox Text="{Binding RiskyCandidateCount, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsRiskyCandidateCountEnabled}"
                                     Width="40"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource XT.ToolbarTextBox}"
                                     TextAlignment="Center"
                                     ToolTip="위험문장 다중후보 저장값(2~8)입니다. 기본 모델이 지원하지 않으면 1개만 적용되며, 저장값은 지원 모델로 전환할 때 다시 사용합니다. 책/품질 모델에는 각 모델의 지원 여부를 적용합니다." />
                            <TextBlock Text="{Binding EffectiveRiskyCandidateSummary}" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Foreground="{StaticResource XT.MutedTextBrush}" />

                            <CheckBox Content="출력 예산 자동 조절(실험)" IsChecked="{Binding EnableAdaptiveOutputBudget}" VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="요청 길이에 맞춰 출력 상한을 보수적으로 조절합니다. 직접 지정한 Max out을 넘지 않습니다. 기본은 꺼짐이며 번역 표본 비교 후 사용하세요." />
                            <CheckBox Content="책 원문 문맥(실험)" IsChecked="{Binding EnableBookContext}" VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="책 본문 번역에 확인 가능한 제목과 인접한 원문 일부를 참고로 전달합니다. 이전 생성 번역은 전달하지 않습니다. 기본은 꺼짐이며 입력 토큰이 늘어날 수 있습니다." />

                            <CheckBox Content="책 제목 모델 분리" IsChecked="{Binding EnableBookFullModelOverride}" VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="책 제목(BOOK:FULL)을 오른쪽 모델로 번역합니다. 기존 설정은 제목에만 적용됩니다." />
                            <CheckBox Content="책 본문 모델 분리" IsChecked="{Binding EnableBookBodyModelOverride}" VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="책 본문(BOOK:DESC)을 오른쪽 모델로 번역합니다. 선택하지 않은 항목은 기본 모델을 사용합니다." />
                            <ComboBox ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding BookFullModel}"
                                      IsEnabled="{Binding IsBookModelOverrideEnabled}"
                                      Width="220"
                                      VerticalAlignment="Center"
                                      Margin="6,0,0,0"
                                      Style="{StaticResource XT.ToolbarComboBox}"
                                      ToolTip="선택한 책 제목·본문에 공통으로 사용할 모델입니다. (예: gemini-3.8-flash)" />
                        </WrapPanel>

                        <TextBlock Text="API 키" FontWeight="SemiBold" Foreground="{StaticResource XT.MutedTextBrush}" Margin="0,12,0,4" />

                        <TextBlock Text="Gemini" FontWeight="SemiBold" Foreground="{StaticResource XT.MutedTextBrush}" Margin="0,4,0,4" />

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="저장된 키:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding SavedApiKeys}"
                                      SelectedItem="{Binding SelectedSavedApiKey}"
                                      DisplayMemberPath="DisplayLabel"
                                      Width="220"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource XT.ToolbarComboBox}"
                                      ToolTip="저장된 API 키 목록입니다. 선택하면 현재 키가 해당 값으로 전환됩니다." />
                            <TextBlock Text="이름:" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <TextBox Text="{Binding SavedApiKeyName, UpdateSourceTrigger=PropertyChanged}" Width="140" VerticalAlignment="Center" Style="{StaticResource XT.ToolbarTextBox}"
                                     ToolTip="저장할 키의 표시 이름입니다. (예: Paid-Project-A)" />
                            <TextBlock Text="API 키:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <PasswordBox x:Name="ApiKeyBox"
                                         Width="260"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource XT.ToolbarPasswordBox}"
                                         PasswordChanged="ApiKeyBox_OnPasswordChanged" />

                            <Button Content="저장"
                                    Command="{Binding SaveApiKeyCommand}"
                                    Style="{StaticResource XT.ToolbarButton}"
                                    Margin="6,0,0,0"
                                    ToolTip="현재 입력된 API 키를 저장 목록에 추가합니다." />
                            <Button Content="삭제"
                                    Command="{Binding ClearSavedApiKeyCommand}"
                                    Style="{StaticResource XT.ToolbarButton}"
                                    Margin="6,0,0,0"
                                    ToolTip="선택된 저장 키(또는 현재 키)를 저장 목록에서 삭제합니다." />
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                            <CheckBox Content="자동 키 전환"
                                      IsChecked="{Binding EnableApiKeyFailover}"
                                      VerticalAlignment="Center"
                                      ToolTip="번역 중 401/403/429/5xx/네트워크/타임아웃 오류가 발생하면 저장된 다른 API 키로 자동 전환합니다." />
                        </WrapPanel>

                        <TextBlock Text="도구" FontWeight="SemiBold" Foreground="{StaticResource XT.MutedTextBrush}" Margin="0,12,0,4" />
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsWorkspaceInteractive}">
                            <Button Content="비용 추정" Command="{Binding EstimateCostCommand}" Style="{StaticResource XT.ToolbarButton}"
                                    ToolTip="현재 설정/모델 기준으로 토큰·비용을 추정합니다." />
                            <Button Content="태그 교정" Command="{Binding FixMagDurPlaceholdersCommand}" Style="{StaticResource XT.ToolbarButton}"
                                    ToolTip="현재 번역 결과에서 &lt;mag&gt;/&lt;dur&gt; 플레이스홀더 오번역(자리/역할)을 자동 교정합니다. (API 호출 없음)" />
                            <Button Content="후처리 재적용" Command="{Binding ReapplyPostEditsCommand}" Style="{StaticResource XT.ToolbarButton}"
                                    ToolTip="이미 번역된 항목에 플레이스홀더/단위/조사 후처리를 다시 적용합니다. (API 호출 없음)" />
                            <Button Content="시리즈 TM 가져오기" Command="{Binding ImportFranchiseTranslationMemoryCommand}" Style="{StaticResource XT.ToolbarButton}"
                                    ToolTip="TSV(Source&lt;TAB&gt;Target) 파일을 시리즈 TM으로 가져옵니다. (API 호출 없음)" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource XT.CardBorder}" Padding="10">
        <TabControl x:Name="MainTabs" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource XT.TabItem}" IsEnabled="{Binding IsWorkspaceInteractive}">
            <TabItem Header="문자열" DataContext="{Binding StringsTab}">
                <views:StringsTabView />
            </TabItem>

            <TabItem Header="모델 비교" DataContext="{Binding CompareTab}">
                <views:CompareTabView />
            </TabItem>

            <TabItem Header="품질 검사" DataContext="{Binding LqaTab}">
                <views:LqaTabView />
            </TabItem>

            <TabItem Header="프로젝트 용어집" DataContext="{Binding ProjectGlossaryTab}">
                <views:ProjectGlossaryTabView />
            </TabItem>

            <TabItem Header="전체 용어집" DataContext="{Binding GlobalGlossaryTab}">
                <views:GlobalGlossaryTabView />
            </TabItem>

            <TabItem Header="시리즈 TM" DataContext="{Binding FranchiseTranslationMemoryTab}">
                <views:GlobalTranslationMemoryTabView />
            </TabItem>

            <TabItem Header="프롬프트" DataContext="{Binding PromptTab}">
                <views:PromptTabView />
            </TabItem>

            <TabItem Header="프로젝트 문맥" DataContext="{Binding ProjectContextTab}">
                <views:ProjectContextTabView />
            </TabItem>

            <TabItem Header="API 기록" DataContext="{Binding ApiLogsTab}">
                <views:ApiLogsTabView />
            </TabItem>
        </TabControl>
        </Border>

        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem>
                <StatusBarItem.Style>
                    <Style TargetType="StatusBarItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPluginIoBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StatusBarItem.Style>
                <Button Content="ESP 읽기/저장 취소" Command="{Binding CancelPluginIoCommand}" IsEnabled="{Binding IsPluginIoBusy}"
                        Style="{StaticResource XT.ToolbarButton}" Margin="0,0,6,0" />
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar Width="220" Height="16" Minimum="0" Maximum="1" Value="{Binding ProgressRatio, Mode=OneWay}" Style="{StaticResource XT.ProgressBar}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Foreground="{StaticResource XT.MutedTextBrush}" TextWrapping="NoWrap"
                           ToolTip="완료: 번역을 마쳤거나 직접 수정한 행 · 대기: '번역 시작'을 누르면 번역할 행(대기·오류)">
                    <Run Text="{Binding DoneCount, StringFormat=완료 {0}}" />
                    <Run Text=" · " />
                    <Run Text="{Binding PendingCount, StringFormat=대기 {0}}" />
                    <Run Text=" · " />
                    <Run Text="{Binding TotalCount, StringFormat=전체 {0}}" />
                    <Run Text=" · " />
                    <Run Text="{Binding ProgressRatio, Mode=OneWay, StringFormat={}{0:P0}}" />
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem>
                <StatusBarItem.Style>
                    <Style TargetType="StatusBarItem">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProjectLoaded}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StatusBarItem.Style>
                <TextBlock Text="{Binding CurrentXmlFileName, StringFormat=파일: {0}}"
                           MaxWidth="360"
                           TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding LastCostEstimateSummary}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Shown while a file is dragged over the window; drops still reach the controls underneath. -->
        <Border x:Name="DropOverlay" Grid.RowSpan="3" Panel.ZIndex="100" IsHitTestVisible="False"
                Visibility="Collapsed" CornerRadius="8" BorderThickness="2"
                BorderBrush="{StaticResource XT.AccentBrush}">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource XT.SurfaceColor}" Opacity="0.85" />
            </Border.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="DropOverlayTitle" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"
                           Foreground="{StaticResource XT.TextBrush}" />
                <TextBlock x:Name="DropOverlayDetail" Margin="0,6,0,0" TextAlignment="Center"
                           Foreground="{StaticResource XT.MutedTextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
