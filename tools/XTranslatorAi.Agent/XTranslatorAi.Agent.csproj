<Project Sdk="Microsoft.NET.Sdk">
  <!-- The agent-mode CLI (tullius.exe): a subscription app's model runs it to translate a plugin with no API key.
       It references the App for the GUI's run wiring, game dictionary, glossary and TM; it calls no AI itself. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>tullius</AssemblyName>
    <RootNamespace>XTranslatorAi.Agent</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XTranslatorAi.App\XTranslatorAi.App.csproj" />
    <ProjectReference Include="..\..\src\XTranslatorAi.Core\XTranslatorAi.Core.csproj" />
  </ItemGroup>
</Project>
